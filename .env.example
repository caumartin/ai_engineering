# Copia este archivo a .env y completa los valores
GOOGLE_API_KEY=tu-api-key-de-google-ai-studio
REDIS_URL=redis://localhost:6379
GEMINI_MODEL=gemini-3.7-flash

# Observabilidad (Phoenix corriendo en Docker)
ENABLE_PHOENIX=true
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT=multi-agent-api

# Opcional: LangSmith (si no usas Phoenix)
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=multi-agent-api
